<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="XVV SaveVault" Width="1120" Height="760" MinWidth="900" MinHeight="650" Background="#141B23" Foreground="#EDF3FA" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF3FA"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#67DEC4"/><Setter Property="Foreground" Value="#10251F"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#DDFCF6" BorderThickness="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#141B23"/><Setter Property="Foreground" Value="#EDF3FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#202B38" Padding="16" CornerRadius="8" BorderBrush="#344456" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#254039"/><Setter TargetName="Card" Property="BorderBrush" Value="#67DEC4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#1B2531"/><Setter Property="Foreground" Value="#EDF3FA"/><Setter Property="RowBackground" Value="#1B2531"/><Setter Property="AlternatingRowBackground" Value="#22303D"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2A3949"/><Setter Property="Foreground" Value="#C0F4E8"/><Setter Property="Padding" Value="12"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="XVV / SAVE PROTECTION" FontSize="11" Foreground="#67DEC4" FontWeight="Bold"/><TextBlock Text="SaveVault" FontSize="34" FontWeight="SemiBold"/><TextBlock Name="Subtitle" Text="Oyunun kalsın. İlerlemen kaybolmasın." Foreground="#9DAFC2" Margin="0,5,0,0"/></StackPanel><Button Name="Language" Content="English" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2C3C4D" Foreground="#EDF3FA"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Name="GamesLabel" Text="Oyunlarım" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/><Button Name="AddGame" Content="+ Oyun ekle" Margin="0,0,0,14" Grid.Row="1"/><ListBox Name="Profiles" Grid.Row="2"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Source}" FontSize="11" Foreground="#9DAFC2" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Name="RemoveGame" Grid.Row="3" Content="Listeden kaldır" Background="#2C3C4D" Foreground="#CED9E5" Margin="0,12,0,0" IsEnabled="False"/></Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#202D39" CornerRadius="12" Padding="20"><StackPanel><TextBlock Name="GameTitle" Text="İlk oyununu ekle" FontSize="24" FontWeight="SemiBold"/><TextBlock Name="GamePath" Text="Yedeklemek istediğin kayıt klasörünü seçerek başla." Foreground="#A6B7CA" Margin="0,8,0,16"/><WrapPanel><Button Name="Backup" Content="Şimdi yedekle" IsEnabled="False"/><Button Name="OpenSource" Content="Kayıt klasörü" Background="#344657" Foreground="#EDF3FA" IsEnabled="False"/></WrapPanel></StackPanel></Border>
    <TextBlock Name="CloseGameHint" Grid.Row="1" Text="Yedekleme ve geri yükleme öncesinde oyunu kapat. Bulut eşitlemesinin tamamlanmasını bekle." Foreground="#A6B7CA" Margin="0,14,0,16"/>
    <DockPanel Grid.Row="2" Margin="0,0,0,12"><Button Name="Refresh" Content="Yenile" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,7" Background="#2C3C4D" Foreground="#EDF3FA"/><TextBlock Name="HistoryTitle" Text="Yedek geçmişi" FontSize="19" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="3"><DataGrid Name="History"><DataGrid.Columns><DataGridTextColumn Header="Tarih / Date" Binding="{Binding Date}" Width="2*"/><DataGridTextColumn Header="Dosya / Files" Binding="{Binding Files}" Width="*"/><DataGridTextColumn Header="MB" Binding="{Binding SizeMB}" Width="*"/><DataGridTextColumn Header="Tür / Type" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Durum / Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Name="EmptyHistory" Text="Henüz yedek yok." Foreground="#9DAFC2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
    <StackPanel Grid.Row="4" Margin="0,14,0,0"><WrapPanel><Button Name="Restore" Content="Geri yükle" IsEnabled="False"/><Button Name="Verify" Content="Yedeği doğrula" Background="#344657" Foreground="#EDF3FA" IsEnabled="False"/></WrapPanel><Expander Name="StorageExpander" Header="Yedek konumu ve ayrıntılar" Foreground="#A6B7CA" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Name="BackupPath" Foreground="#A6B7CA"/><WrapPanel Margin="0,10,0,0"><Button Name="ChooseStorage" Content="Konumu değiştir" Background="#2C3C4D" Foreground="#EDF3FA"/><Button Name="OpenStorage" Content="Yedekleri aç" Background="#2C3C4D" Foreground="#EDF3FA"/></WrapPanel><TextBlock Name="SafetyHint" Text="Geri yükleme önce güncel kayıtları yedekler. Önceki klasör de korunur. ZIP yedekleri şifrelenmez." Foreground="#9DAFC2" Margin="0,12,0,0"/></StackPanel></Expander></StackPanel>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,22,0,0"><ProgressBar Name="Progress" Height="4" BorderThickness="0" Foreground="#67DEC4" Background="#2A3949"/><TextBlock Name="Status" Text="Hazır • XVV SaveVault 1.0" Foreground="#A6B7CA" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
